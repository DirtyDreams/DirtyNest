# DirtyNest environment template — copy to .env.local and fill in values.
# NEVER commit real secrets. All values here are placeholders.
#
# Dev mode (native sidecar/web on host): use localhost URLs below.
# Docker Compose overrides the sidecar's service URLs to in-network names
# (http://qdrant:6333, redis://redis:6379/0, ...) automatically — see
# docker-compose.yml. Only POSTGRES_PASSWORD is required by compose.

# PostgreSQL connection string (used by web, backend, sidecar, drizzle-kit)
DATABASE_URL=postgresql://dirtynest:CHANGE_ME@localhost:5432/dirtynest

# Sidecar FastAPI service (web → sidecar REST/WebSocket)
NEXT_PUBLIC_SIDECAR_URL=http://localhost:8000

# Qdrant vector store (sidecar memory_service / F4 Knowledge Vault)
QDRANT_URL=http://localhost:6333

# Redis (sidecar cron_service; in-memory fallback if unset)
REDIS_URL=redis://localhost:6379/0

# SearXNG metasearch (F3/F4 research tool)
SEARXNG_URL=http://localhost:8080

# Ollama LLM runtime (F3 agent backend, ADR-05)
OLLAMA_URL=http://localhost:11434

# Docker Compose: Postgres superuser password (required by docker-compose.yml)
POSTGRES_PASSWORD=CHANGE_ME

# Telemetry prober host overrides (compose sets these to in-network names;
# dev mode probes 127.0.0.1 by default — no need to set here)
# PROBE_HOST_POSTGRES=postgres
# PROBE_HOST_QDRANT=qdrant
# PROBE_HOST_REDIS=redis
# PROBE_HOST_SEARXNG=searxng
# PROBE_HOST_OLLAMA=ollama
